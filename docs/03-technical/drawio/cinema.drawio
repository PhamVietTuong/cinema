 Người dùng: Invoice.UserId → User &amp;nbsp;• Đặt vé → Giá/KM: Invoice.PromotionProgramId → PromotionProgram &amp;nbsp;• Người dùng → Phim: Comment / Evaluation.MovieId → Movie&lt;br&gt;• Người dùng → Rạp: User.TheaterId → Theater (nhân viên) &amp;nbsp;• Giá/KM → Rạp: TimeSlot / TicketPrice / RoomType... → Theater, RoomType &amp;nbsp;• Giá/KM → Phim: PromotionProgram.MovieId → Movie; → MemberShip" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1700" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg3" name="3. ERD đặt vé &amp; thanh toán"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_2" value="ERD chi tiết — đặt vé &amp; thanh toán" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="p3_3" value="User" style="html=1;whiteSpace=wrap;fontSize=12;swimlane;fontStyle=1;horizontal=1;startSize=26;collapsible=0;fillColor=#7b4fa3;strokeColor=#7b4fa3;fontColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="224" as="geometry"/></mxCell><mxCell id="p3_4" value="&lt;b&gt;PK&lt;/b&gt;&amp;nbsp;&amp;nbsp;Id" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="p3_3"><mxGeometry y="26" width="260" height="18" as="geometry"/></mxCell><mxCell id="p3_5" value="&lt;i&gt;&lt;font color='#1f6fb2'&gt;FK&lt;/font&gt;&lt;/i&gt;&amp;nbsp;&amp;nbsp;UserTypeId" style="text;html=1;align=left
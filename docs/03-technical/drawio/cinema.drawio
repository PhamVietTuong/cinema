strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="660" width="300" height="56" as="geometry"/></mxCell><mxCell id="p7_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=none;endArrow=none;strokeColor=#d79b00;" edge="1" parent="1" source="p7_30" target="p7_43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_45" value="kế thừa: làm được mọi việc của TheaterStaff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p7_30" target="p7_18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="800"/><mxPoint x="705" y="800"/></Array></mxGeometry></mxCell><mxCell id="p7_46" value="Quyền theo JWT: mỗi token đúng 1 role; TheaterStaff luôn bị giới hạn theo theaterId trong token. Truy cập sai phạm vi → 403." style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=12;fontColor=#666666;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1700" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg8" name="8. Tính giá vé"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8_2" value="Quy trình tính giá vé → thanh toán" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p8_3" value="Ghế được chọn&lt;br&gt;(suất chiếu, phòng, loại khách)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="70" as="geometry"/></mxCell><mxCell id="p8_4" value="Ngày chiếu là&lt;br&gt;ngày lễ (Holiday)?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="85" width="200" height="100" as="geometry"/></mxCell><mxCell id="p8_5" value="factor = Holiday.PriceMultiplier&lt;br&gt;(bỏ qua ma trận khung giờ)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="p8_6" value="Tìm TimeSlot của rạp&lt;br&gt;chứa giờ chiếu" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_7" value="Có TicketPrice (rạp,&lt;br&gt;loại phòng, khung giờ,&lt;br&gt;thứ trong tuần)?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="245" width="220" height="100" as="geometry"/></mxCell><mxCell id="p8_8" value="factor = TicketPrice.PriceMultiplier" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="900" y="260" width="240" height="70" as="geometry"/></mxCell><mxCell id="p8_9" value="factor = 1.0" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="590" y="420" width="220" height="60" as="geometry"/></mxCell><mxCell id="p8_10" value="Giá vé = làm tròn 2 số lẻ của&lt;br&gt;Giá(loại phòng, loại khách) × factor&lt;br&gt;+ phụ thu 3D + ShowTimeRoom.BasePrice" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="300" height="100" as="geometry"/></mxCell><mxCell id="p8_11" value="Chọn tối đa 1 PromotionProgram:&lt;br&gt;mã khách nhập HOẶC tự áp dụng&lt;br&gt;(xem trang 9)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="300" height="80" as="geometry"/></mxCell><mxCell id="p8_12" value="Đổi điểm thưởng (tùy chọn): min(điểm yêu cầu,&lt;br&gt;số dư, FinalAmount ÷ PointValueVnd);&lt;br&gt;trừ điểm ngay, nguyên tử" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="300" height="90" as="geometry"/></mxCell><mxCell id="p8_13" value="FinalAmount ≤ 0?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="850" width="200" height="100" as="geometry"/></mxCell><mxCell id="p8_14" value="Paid ngay,&lt;br&gt;PaymentReference = ZERO-AMOUNT&lt;br&gt;(không qua cổng thanh toán)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="865" width="260" height="70" as="geometry"/></mxCell><mxCell id="p8_15" value="Chuyển sang VNPay&lt;br&gt;(xem trang 5)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1250" y="865" width="240" height="70" as="geometry"/></mxCell><mxCell id="p8_16" value="Khi hóa đơn thành Paid (chỉ khi có tài khoản khách):&lt;br&gt;điểm cộng = ⌊FinalAmount ÷ PointsPerUnit⌋&lt;br&gt;(mặc định 1.000đ = 1 điểm);&lt;br&gt;hạng thành viên = hạng cao nhất đủ MinPoints" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="1030" width="400" height="100" as="geometry"/></mxCell><mxCell id="p8_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_3" target="p8_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_18" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_4" target="p8_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_19" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_4" target="p8_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_6" target="p8_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_21" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_7" target="p8_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_22" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_7" target="p8_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_8" target="p8_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_9" target="p8_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p8_5" target="p8_10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="135"/><mxPoint x="1260" y="450"/></Array></mxGeometry></mxCell><mxCell id="p8_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_10" target="p8_11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_11" target="p8_12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_12" target="p8_13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_29" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_13" target="p8_14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_30" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_13" target="p8_15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_14" target="p8_16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_32" value="IPN thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p8_15" target="p8_16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_33" value="&lt;b&gt;Điều kiện đặt vé ONLINE&lt;/b&gt; (bán tại quầy được miễn)&lt;br&gt;1. Suất, phim, rạp đều active và chưa quá giờ mở bán&lt;br&gt;2. Số ghế ≤ Theater.MaxSeatsPerBooking (mặc định 10; ghế đôi tính 2)&lt;br&gt;3. Phim MinAge ≥ 13 phải tick xác nhận độ tuổi (AgeConfirmed)&lt;br&gt;4. Loại khách RequiresIdCheck chỉ bán tại quầy&lt;br&gt;Ghế đôi (SeatGroupId) phải đặt cùng cặp." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="500" height="160" as="geometry"/></mxCell><mxCell id="p8_34" value="&lt;b&gt;Loại khách ↔ loại ghế ↔ loại phòng&lt;/b&gt;&lt;br&gt;• Không có dòng RoomTypePatronCategoryPrice cho (loại phòng, loại khách) = không bán loại khách đó ở phòng đó, không có giá dự phòng.&lt;br&gt;• Không có dòng (loại khách, loại ghế) = không đặt được loại ghế đó." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="500" height="130" as="geometry"/></mxCell><mxCell id="p8_35" value="&lt;b&gt;Lưu ý công thức&lt;/b&gt;&lt;br&gt;• Ngày lễ thay thế hoàn toàn ma trận khung giờ, không cộng dồn.&lt;br&gt;• Phụ thu 3D và BasePrice cộng phẳng, không bị nhân với factor.&lt;br&gt;• Hệ số seed mặc định: Sáng 0.9, Chiều 1.0, Tối 1.2, Khuya 0.85 (nhân thêm hệ số loại phòng).&lt;br&gt;• Không giảm giá % theo hạng thành viên." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg9" name="9. Khuyến mãi &amp; điểm thưởng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9_2" value="Khuyến mãi (PromotionProgram) và điểm thưởng" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p9_3" value="A. Chọn khuyến mãi khi tính giá" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=15;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="600" height="26" as="geometry"/></mxCell><mxCell id="p9_4" value="Khách thanh toán&lt;br&gt;(bước tính giá)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="p9_5" value="Khách nhập mã KM?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="220" height="100" as="geometry"/></mxCell><mxCell id="p9_6" value="FindUsableProgramByCode: IsPublished,&lt;br&gt;trong [StartDate, EndDate],&lt;br&gt;dưới MaxUsage, đúng phạm vi" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="620" y="105" width="320" height="80" as="geometry"/></mxCell><mxCell id="p9_7" value="Mã dùng được?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="160" height="90" as="geometry"/></mxCell><mxCell id="p9_8" value="Báo lỗi: mã không dùng được&lt;br&gt;(đặt vé thất bại)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="260" height="70" as="geometry"/></mxCell><mxCell id="p9_9" value="Tự áp dụng: FindBestAutoApplyProgram&lt;br&gt;(chỉ Everyone / Members; bỏ chương trình&lt;br&gt;đã hết MaxUsage; đúng phim, đúng kênh)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="280" height="90" as="geometry"/></mxCell><mxCell id="p9_10" value="Áp dụng tối đa 1 PromotionProgram / hóa đơn&lt;br&gt;MaxDiscountAmount giới hạn tổng mức giảm&lt;br&gt;Sau đó mới tới bước đổi điểm" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="430" width="380" height="90" as="geometry"/></mxCell><mxCell id="p9_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_4" target="p9_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_12" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_5" target="p9_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_13" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_5" target="p9_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_6" target="p9_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_15" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_7" target="p9_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_16" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_7" target="p9_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_9" target="p9_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_18" value="&lt;b&gt;Quy tắc&lt;/b&gt;&lt;br&gt;• Mỗi chương trình kích hoạt bằng Code HOẶC AutoApply, không cả hai.&lt;br&gt;• Chỉ Everyone / Members được tự áp dụng; StudentOrTeacher, AgeLimit và loại Info (chỉ hiển thị) bị từ chối khi lưu AutoApply.&lt;br&gt;• Không cộng dồn khuyến mãi; không có giảm % theo hạng thành viên; không có thẻ quà tặng." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="620" height="130" as="geometry"/></mxCell><mxCell id="p9_19" value="B. Vòng đời điểm thưởng" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=15;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="600" height="26" as="geometry"/></mxCell><mxCell id="p9_20" value="Đặt vé có đổi điểm" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="200" height="70" as="geometry"/></mxCell><mxCell id="p9_21" value="Trừ điểm ngay lúc đặt:&lt;br&gt;UPDATE Points = Points − n&lt;br&gt;WHERE Points ≥ n (nguyên tử)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="260" height="90" as="geometry"/></mxCell><mxCell id="p9_22" value="Kết cục&lt;br&gt;hóa đơn?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="625" width="180" height="100" as="geometry"/></mxCell><mxCell id="p9_23" value="Cộng điểm = ⌊FinalAmount ÷ PointsPerUnit⌋&lt;br&gt;(chỉ khi có tài khoản, tính trên số tiền&lt;br&gt;thực trả sau mọi khoản giảm)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="590" width="330" height="90" as="geometry"/></mxCell><mxCell id="p9_24" value="Nâng hạng thành viên lên hạng&lt;br&gt;cao nhất đủ MinPoints&lt;br&gt;(không có logic hạ hạng)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1330" y="590" width="270" height="90" as="geometry"/></mxCell><mxCell id="p9_25" value="Hoàn lại điểm đã đổi&lt;br&gt;(RestoreRedeemedPoints)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="920" y="740" width="330" height="70" as="geometry"/></mxCell><mxCell id="p9_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_20" target="p9_21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_21" target="p9_22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_28" value="Paid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_22" target="p9_23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p9_23" target="p9_24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_30" value="Pending hết hạn / admin huỷ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9_22" target="p9_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_31" value="&lt;b&gt;Tỷ lệ theo từng rạp&lt;/b&gt; (LoyaltySetting, không có cài đặt toàn hệ thống): mặc định &lt;b&gt;1.000đ = 1 điểm&lt;/b&gt;, &lt;b&gt;100 điểm = 1.000đ&lt;/b&gt; (1 điểm = 10đ). Hai tỷ lệ độc lập nhau.&lt;br&gt;Admin đổi từ Paid sang Cancelled/Failed: ghế được nhả nhưng điểm đã dùng &lt;b&gt;không&lt;/b&gt; được hoàn (quyết định thủ công)." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1200" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg10" name="10. Bán vé quầy &amp; soát vé"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10_2" value="Bán vé tại quầy và soát vé ở cổng (CinemaStaff)" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p10_3" value="A. Bán vé tại quầy" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=15;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="400" height="26" as="geometry"/></mxCell><mxCell id="p10_4" value="Nhân viên: Quote&lt;br&gt;(báo giá)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="p10_5" value="Sell: chọn ghế,&lt;br&gt;thu tiền (tenders)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="p10_6" value="Cần ghi đè giá&lt;br&gt;(price override)?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="95" width="220" height="100" as="geometry"/></mxCell><mxCell id="p10_7" value="Chỉ Admin (Approvers) được ghi đè;&lt;br&gt;TheaterStaff bị từ chối 403" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="280" height="70" as="geometry"/></mxCell><mxCell id="p10_8" value="SellAtCounterAsync (1 transaction):&lt;br&gt;Invoice tạo ở trạng thái Paid ngay,&lt;br&gt;không qua Pending" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="300" height="90" as="geometry"/></mxCell><mxCell id="p10_9" value="&lt;b&gt;Khác với đặt online&lt;/b&gt;&lt;br&gt;• Miễn 4 điều kiện đặt online&lt;br&gt;• Không có UserId → không tích điểm&lt;br&gt;• Vẫn chống đặt trùng ghế (index DB + semaphore)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="240" width="380" height="110" as="geometry"/></mxCell><mxCell id="p10_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p10_4" target="p10_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p10_5" target="p10_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_12" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p10_6" target="p10_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_13" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p10_6" target="p10_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_14" value="Admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p10_7" target="p10_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_15" value="B. Soát vé ở cổng" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=15;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="400" height="26" as="geometry"/></mxCell><mxCell id="p10_16" value="Nhân viên cổng:&lt;br&gt;quét mã QR vé" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="200" height="70" as="geometry"/></mxCell><mxCell id="p10_17" value="GateManager.EvaluateScan&lt;br&gt;kiểm tra vé; ghi AuditLog&lt;br&gt;cho mọi lần quét" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="585" width="260" height="100" as="geometry"/></mxCell><mxCell id="p10_18" value="&lt;b&gt;Admitted&lt;/b&gt; — vé Paid, còn hiệu lực, đúng rạp, trong khung giờ → UPDATE nguyên tử IsUsed 0→1" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_20" value="&lt;b&gt;AlreadyUsed&lt;/b&gt; — vé đã được quét" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="532" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_22" value="&lt;b&gt;NotFound&lt;/b&gt; — không có vé" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="594" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_24" value="&lt;b&gt;NotPaid&lt;/b&gt; — hóa đơn chưa Paid hoặc vé đã bị hủy" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="656" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_26" value="&lt;b&gt;WrongTheater&lt;/b&gt; — vé của rạp khác (không lộ chi tiết)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="718" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_28" value="&lt;b&gt;TooEarly / Expired / WrongShowTime&lt;/b&gt; — ngoài khung giờ của suất" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="780" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_30" value="&lt;b&gt;AgeCheckRequired&lt;/b&gt; — phim MinAge ≥ 13: vé giữ nguyên chưa dùng, quét lại kèm AgeConfirmed" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="842" width="560" height="52" as="geometry"/></mxCell><mxCell id="p10_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="1" source="p10_17" target="p10_30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p10_16" target="p10_17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_33" value="&lt;b&gt;Banner thêm khi cho vào&lt;/b&gt; (không chặn): hạng K → GuardianRequired (người giám hộ); hạng khách RequiresIdCheck → nhắc kiểm tra giấy tờ." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="910" width="560" height="60" as="geometry"/></mxCell><mxCell id="p10_34" value="&lt;b&gt;PaymentController.ValidateTicket&lt;/b&gt; (chỉ Admin) dùng cùng thao tác admit nguyên tử nhưng không kiểm tra rạp hay khung giờ." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="985" width="560" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg11" name="11. Lên lịch chiếu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11_2" value="Lên lịch chiếu — chuỗi kiểm tra khi tạo / sửa suất (ShowTimeManager)" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p11_3" value="1. Cửa sổ giờ hợp lệ&lt;br&gt;• giờ kết thúc sau giờ bắt đầu&lt;br&gt;• khi tạo mới: giờ bắt đầu phải ở tương lai (sửa thì bỏ qua)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="560" height="100" as="geometry"/></mxCell><mxCell id="p11_4" value="Từ chối: 'A showtime must end after it starts.'&lt;br&gt;'A showtime cannot be scheduled in the past.'" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="560" height="80" as="geometry"/></mxCell><mxCell id="p11_5" value="không đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_3" target="p11_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_6" value="2. Thời lượng suất ≥ thời lượng phim&lt;br&gt;(bỏ qua nếu Duration ≤ 0)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="560" height="100" as="geometry"/></mxCell><mxCell id="p11_7" value="Từ chối: '{phim} runs {N} minutes; the showtime must end no earlier than {giờ}.'" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="225" width="560" height="80" as="geometry"/></mxCell><mxCell id="p11_8" value="không đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_6" target="p11_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_9" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_3" target="p11_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_10" value="3. Phim còn chiếu&lt;br&gt;• Movie.IsActive&lt;br&gt;• ngày bắt đầu nằm trong [ReleaseDate, EndDate]&lt;br&gt;  (EndDate null = không giới hạn)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="560" height="100" as="geometry"/></mxCell><mxCell id="p11_11" value="Từ chối: '… no longer showing; reactivate the movie before scheduling it'&lt;br&gt;hoặc ngoài khoảng ngày chiếu" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="560" height="80" as="geometry"/></mxCell><mxCell id="p11_12" value="không đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_10" target="p11_11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_13" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_6" target="p11_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_14" value="4. Rạp và phòng sẵn sàng&lt;br&gt;• Theater.IsActive (kiểm tra trước)&lt;br&gt;• Room.Status = Active (Maintenance có thông báo riêng)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="560" height="100" as="geometry"/></mxCell><mxCell id="p11_15" value="Từ chối: Rạp ngừng hoạt động / phòng đang bảo trì / phòng không phục vụ" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="495" width="560" height="80" as="geometry"/></mxCell><mxCell id="p11_16" value="không đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_14" target="p11_15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_17" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_10" target="p11_14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_18" value="5. Phòng hỗ trợ định dạng&lt;br&gt;suất 3D cần RoomType.SupportsThreeD (luôn kiểm tra)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="560" height="100" as="geometry"/></mxCell><mxCell id="p11_19" value="Từ chối: Phòng không hỗ trợ 3D" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="560" height="80" as="geometry"/></mxCell><mxCell id="p11_20" value="không đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_18" target="p11_19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_21" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_14" target="p11_18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_22" value="6. Không trùng suất khác trong phòng&lt;br&gt;(mở rộng mỗi bên bằng TurnoverBufferMinutes của loại phòng)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="755" width="560" height="100" as="geometry"/></mxCell><mxCell id="p11_23" value="Từ chối: 2 thông báo khác nhau: trùng giờ thật sự / khoảng nghỉ giữa suất quá ngắn" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="765" width="560" height="80" as="geometry"/></mxCell><mxCell id="p11_24" value="không đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_22" target="p11_23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_25" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_18" target="p11_22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_26" value="Lưu ShowTime + ShowTimeRoom&lt;br&gt;(thực tế mỗi suất chỉ 1 phòng)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="560" height="70" as="geometry"/></mxCell><mxCell id="p11_27" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p11_22" target="p11_26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_28" value="Một số kiểm tra (ví dụ phim còn chiếu) chỉ áp cho suất ở tương lai; chi tiết xem business-rules.md mục 4." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="890" width="560" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg12" name="12. Đăng nhập &amp; 2FA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12_2" value="Đăng nhập, khóa tài khoản và 2FA (AuthManager)" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p12_3" value="Nhập email + mật khẩu" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="p12_4" value="Đang bị khóa tạm?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="220" height="100" as="geometry"/></mxCell><mxCell id="p12_5" value="401: tài khoản bị khóa,&lt;br&gt;thử lại sau n phút" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="260" height="70" as="geometry"/></mxCell><mxCell id="p12_6" value="Mật khẩu đúng?&lt;br&gt;(PBKDF2-SHA256)" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="220" height="100" as="geometry"/></mxCell><mxCell id="p12_7" value="401 'Invalid credentials.'&lt;br&gt;tăng đếm sai; lần 5 liên tiếp&lt;br&gt;→ khóa 15 phút" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="265" width="260" height="90" as="geometry"/></mxCell><mxCell id="p12_8" value="Email đã xác nhận?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="220" height="100" as="geometry"/></mxCell><mxCell id="p12_9" value="401 'Please verify your&lt;br&gt;email address before signing in.'" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="435" width="260" height="70" as="geometry"/></mxCell><mxCell id="p12_10" value="Bật 2FA?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="220" height="100" as="geometry"/></mxCell><mxCell id="p12_11" value="Cấp JWT&lt;br&gt;(đăng nhập thành công,&lt;br&gt;xóa đếm sai và khóa)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="605" width="260" height="80" as="geometry"/></mxCell><mxCell id="p12_12" value="Sinh mã 6 số, băm SHA-256,&lt;br&gt;hạn 5 phút; gửi email (+SMS)&lt;br&gt;Trả RequiresTwoFactor, chưa có token" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="780" width="260" height="90" as="geometry"/></mxCell><mxCell id="p12_13" value="Khách nhập mã 6 số&lt;br&gt;(VerifyTwoFactor)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="640" y="785" width="200" height="80" as="geometry"/></mxCell><mxCell id="p12_14" value="Mã đúng, chưa dùng,&lt;br&gt;còn hạn?" style="html=1;whiteSpace=wrap;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="775" width="220" height="100" as="geometry"/></mxCell><mxCell id="p12_15" value="401 'Invalid or expired code.'&lt;br&gt;(tính vào 5 lần sai; lần 5 hủy mã chờ&lt;br&gt;và khóa tài khoản)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="940" width="320" height="80" as="geometry"/></mxCell><mxCell id="p12_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_3" target="p12_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_17" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_4" target="p12_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_18" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_4" target="p12_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_19" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_6" target="p12_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_20" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_6" target="p12_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_21" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_8" target="p12_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_22" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_8" target="p12_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_23" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_10" target="p12_11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_24" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_10" target="p12_12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_12" target="p12_13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_13" target="p12_14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_27" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="p12_14" target="p12_11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="645"/></Array></mxGeometry></mxCell><mxCell id="p12_28" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="p12_14" target="p12_15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_29" value="&lt;b&gt;Google / Facebook&lt;/b&gt;&lt;br&gt;• Bỏ qua 2FA của ứng dụng&lt;br&gt;• Chưa có email → tự tạo tài khoản Customer&lt;br&gt;• Email có nhưng chưa xác nhận → tự xác nhận&lt;br&gt;• Google bắt buộc EmailVerified" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="480" height="130" as="geometry"/></mxCell><mxCell id="p12_30" value="&lt;b&gt;JWT&lt;/b&gt;&lt;br&gt;• HMAC-SHA256, hạn mặc định 24 giờ&lt;br&gt;• 1 role / token; TheaterStaff có thêm claim theaterId&lt;br&gt;• Không có refresh token và không thu hồi: đổi quyền hay khóa user chỉ có hiệu lực khi token hết hạn" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="480" height="130" as="geometry"/></mxCell><mxCell id="p12_31" value="&lt;b&gt;Quy tắc khác&lt;/b&gt;&lt;br&gt;• Mọi đường đăng nhập yêu cầu Status = Active&lt;br&gt;• Không thể xóa / hạ quyền / vô hiệu hóa Admin cuối cùng&lt;br&gt;• 401 = chưa xác thực (frontend tự đăng xuất); 403 = sai quyền hoặc sai phạm vi rạp" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="480" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg13" name="13. Business Model Canvas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13_2" value="Business Model Canvas — hiện trạng theo tài liệu và mã nguồn" style="html=1;whiteSpace=wrap;fontSize=12;text;fontSize=22;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p13_3" value="&lt;b&gt;Đối tác chính (Key Partners)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• VNPay — cổng thanh toán&lt;br&gt;• Google, Facebook — đăng nhập&lt;br&gt;• OMDb — điểm đánh giá phim&lt;br&gt;• SMTP (email), Twilio (SMS)&lt;br&gt;&lt;font color='#b85450'&gt;⚠ Nhà phát hành / hãng phim: chưa có trong tài liệu&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="340" height="440" as="geometry"/></mxCell><mxCell id="p13_4" value="&lt;b&gt;Hoạt động chính (Key Activities)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Quản lý phim, lịch chiếu, giá vé, khuyến mãi (CinemaAdmin)&lt;br&gt;• Bán vé tại quầy và soát vé (CinemaStaff)&lt;br&gt;• Xử lý sự cố, khóa ghế / phòng&lt;br&gt;• Báo cáo doanh thu, lấp đầy, KPI&lt;br&gt;• Quản lý kho đồ ăn thức uống" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="340" height="220" as="geometry"/></mxCell><mxCell id="p13_5" value="&lt;b&gt;Nguồn lực chính (Key Resources)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Nền tảng: .NET 9, Angular 21, SQL Server&lt;br&gt;• Hệ thống rạp, phòng, ghế (Theater, Room, Seat)&lt;br&gt;• Dữ liệu phim, khách hàng, hóa đơn&lt;br&gt;• Cổng thanh toán đã tích hợp" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="340" height="220" as="geometry"/></mxCell><mxCell id="p13_6" value="&lt;b&gt;Đề xuất giá trị (Value Propositions)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Chọn ghế trực tiếp trên sơ đồ, cập nhật thời gian thực (SignalR)&lt;br&gt;• Chống bán trùng ghế (ràng buộc ở DB)&lt;br&gt;• Thanh toán online qua VNPay&lt;br&gt;• Giá linh hoạt theo khung giờ, loại phòng, ngày lễ&lt;br&gt;• Khuyến mãi và tích điểm đổi vé&lt;br&gt;• Nhắc lịch chiếu qua email" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="340" height="440" as="geometry"/></mxCell><mxCell id="p13_7" value="&lt;b&gt;Quan hệ khách hàng (Customer Relationships)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Tài khoản, hạng thành viên và điểm thưởng&lt;br&gt;• Đánh giá và bình luận phim&lt;br&gt;• Email khuyến mãi theo cơ chế opt-in" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="340" height="220" as="geometry"/></mxCell><mxCell id="p13_8" value="&lt;b&gt;Kênh phân phối (Channels)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Web CinemaUser (đặt vé online)&lt;br&gt;• Quầy vé (CinemaStaff)&lt;br&gt;• Email, SMS thông báo và nhắc lịch&lt;br&gt;• Banner mở đầu, tin tức trên web" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="300" width="340" height="220" as="geometry"/></mxCell><mxCell id="p13_9" value="&lt;b&gt;Phân khúc khách hàng (Customer Segments)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Khách xem phim đặt online (đăng nhập mật khẩu / Google / Facebook)&lt;br&gt;• Khách mua tại quầy, không cần tài khoản&lt;br&gt;• Nhóm ưu đãi theo loại khách của từng rạp (ví dụ học sinh, sinh viên, người cao tuổi)&lt;br&gt;&lt;font color='#b85450'&gt;⚠ Quy mô thị trường, phân khúc mục tiêu: chưa có trong tài liệu&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="80" width="340" height="440" as="geometry"/></mxCell><mxCell id="p13_10" value="&lt;b&gt;Cơ cấu chi phí (Cost Structure)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Hạ tầng máy chủ và SQL Server&lt;br&gt;• Phí cổng thanh toán (VNPay)&lt;br&gt;• Chi phí SMS (Twilio) và email&lt;br&gt;&lt;font color='#b85450'&gt;⚠ Chưa có số liệu: financial-plan.md đang để trống, chủ sở hữu cần bổ sung&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fdf3e0;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="700" height="200" as="geometry"/></mxCell><mxCell id="p13_11" value="&lt;b&gt;Dòng doanh thu (Revenue Streams)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Bán vé xem phim (giá theo ma trận khung giờ × loại phòng × loại khách)&lt;br&gt;• Đồ ăn, thức uống và combo (FoodAndDrink)&lt;br&gt;&lt;font color='#b85450'&gt;⚠ Nguồn thu khác (quảng cáo, thuê rạp, ...) và mô hình / dự báo doanh thu: chưa có trong tài liệu&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#e7f5ec;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="540" width="1060" height="200" as="geometry"/></mxCell><mxCell id="p13_12" value="Ô có dấu ⚠ là chỗ tài liệu hiện chưa có dữ liệu (xem docs/01-business/financial-plan.md và market-research.md mục 3). Canvas này chỉ ghi những gì có trong mã nguồn và tài liệu, không ước lượng số liệu. Cần chủ sở hữu bổ sung trước khi dùng để trình bày với nhà đầu tư." style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1780" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
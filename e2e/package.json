{
  "name": "cinema-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end + API tests for CinemaUser (:4202), CinemaAdmin (:4201), CinemaStaff (:4203) and the Web API (:5102).",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:user": "playwright test --project=user",
    "test:admin": "playwright test --project=admin",
    "test:staff": "playwright test --project=staff",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
